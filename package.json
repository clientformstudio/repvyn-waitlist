{
  "name": "repvyn-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/configure-cloudflare-build.mjs && node scripts/run-framework.mjs build",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "cloudflare:login": "wrangler login",
    "cloudflare:database": "wrangler d1 create repvyn-waitlist --binding DB --update-config=true",
    "cloudflare:migrate": "wrangler d1 migrations apply repvyn-waitlist --remote",
    "cloudflare:deploy": "npm run build && npm run cloudflare:publish",
    "cloudflare:export-emails": "node scripts/export-emails.mjs",
    "cloudflare:build": "npm run build",
    "cloudflare:publish": "wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "react-server-dom-webpack": "19.2.6"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
